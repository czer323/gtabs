#!/bin/sh
# Pre-push hook: block direct pushes to main
# This hook runs before any push. If the push targets the main branch
# on any remote, it is rejected. Use feature branches and PRs instead.

remote="$1"
url="$2"

while read local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/main)
      echo "ERROR: Direct pushes to main are not permitted."
      echo "  Create a feature branch and submit a pull request instead."
      exit 1
      ;;
  esac
done

exit 0
