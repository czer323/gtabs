{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "chrome"]
  },
  "include": ["src/**/*", "scripts/**/*", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["**/*.test.*", "**/*.spec.*"]
}
