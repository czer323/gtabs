{
  "name": "gtabs",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "package": "rm -f gtabs-extension.zip && cd dist && (xattr -cr . 2>/dev/null || true) && zip -rX ../gtabs-extension.zip . -x '*.map' && cd .. && echo 'Packaged → gtabs-extension.zip'",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "dev": "node scripts/build.ts --watch",
    "lint": "oxlint --format agent --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.ts",
    "fix": "npm run lint -- --fix && npm run format && npm run check"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
